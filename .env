# Set to 'true' in .env.local to enable real-time collaboration features.
VITE_COLLAB_ENABLED=false

# API base URL. Absolute and direct: the session cookie is scoped to the API host
# so that the collab WebSocket, which must connect straight to it, receives it too.
# Deliberately unset here: production supplies it as a Docker build arg
# (--build-arg VITE_API_BASE_URL=https://api.incisiveera.com, see
# fly/web/Dockerfile). Vite inlines it at build time, so leaving it out means a
# production bundle can never accidentally ship a localhost API base.
