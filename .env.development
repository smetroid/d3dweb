# Dev-only default. Production passes VITE_API_BASE_URL to the image build as a
# build arg (https://api.incisiveera.com — see fly/web/Dockerfile and
# .github/workflows/deploy-fly.yml); this file's value is never loaded outside
# `vite`/`vite dev`, so it can never leak into a production bundle.
VITE_API_BASE_URL=http://localhost:3001
