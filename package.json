{
  "name": "d3dweb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen-icons": "node scripts/gen-mdi-icons.mjs",
    "prebuild": "npm run gen-icons",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "test": "vitest run",
    "format": "prettier --write src/",
    "prepare": "husky"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "cytoscape": "^3.34.0",
    "cytoscape-cola": "^2.5.1",
    "cytoscape-dagre": "^4.0.0",
    "dagre": "^0.8.5",
    "focus-trap": "^7.5.4",
    "focus-trap-vue": "^4.0.3",
    "gsap": "^3.15.0",
    "jq-web": "^0.6.0",
    "mitt": "^3.0.1",
    "vue": "^3.4.15",
    "vue-cookies": "^1.8.3",
    "vue-router": "^4.2.5",
    "vuetify": "^3.7.4"
  },
  "lint-staged": {
    "*.{vue,js,jsx,cjs,mjs}": "eslint --fix",
    "*.{vue,js,jsx,cjs,mjs,json,css,md}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@mdi/font": "^7.4.47",
    "@rushstack/eslint-patch": "^1.3.3",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vue/eslint-config-prettier": "^8.0.0",
    "canvas": "^3.2.3",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.0.3",
    "vite": "^5.0.11",
    "vitest": "^4.1.10"
  }
